{
  "name": "jabr-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run wasm:build && vite",
    "wasm:build": "wasm-pack build rust/mathlex-bridge --target web --out-dir ../../src/engine/wasm --out-name jabr_mathlex",
    "typecheck": "pnpm run wasm:build && tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:install": "npm install --prefix mcp-server --no-audit --no-fund --package-lock=false",
    "mcp:wasm": "pnpm --dir mcp-server build:wasm",
    "mcp:start": "pnpm --dir mcp-server start",
    "mcp:verify": "pnpm mcp:install && pnpm mcp:wasm && pnpm --dir mcp-server test",
    "verify": "pnpm test && pnpm typecheck && cargo test --locked --manifest-path rust/mathlex-bridge/Cargo.toml && pnpm build && pnpm mcp:verify",
    "verify:security": "pnpm audit --audit-level=high && cargo audit --file rust/mathlex-bridge/Cargo.lock"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
